APP_ENV=development
API_PORT=7302

DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@localhost:7311/retouch
REDIS_URL=redis://localhost:7312

S3_ENDPOINT=http://localhost:7313
# 浏览器访问签名 URL 的地址；空则与 S3_ENDPOINT 相同。deploy profile 由 compose 覆盖
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
S3_URL_TTL=900

# 生产环境必须替换为随机值
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_TTL_HOURS=24

# mock 使用本地占位图，不产生任何调用费用；接真实模型时改为 dashscope
IMAGE_PROVIDER=mock
# Optional default for generation only; does not change editing tools.
GENERATION_PROVIDER=
# Server-only credential file; never expose its contents to the frontend.
L0VEYOU_TOKEN_FILE=
DASHSCOPE_API_KEY=
# 可改为业务空间专属域名 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
IMAGE_EDIT_MODEL=qwen-image-edit-max
PLANNER_MODEL=qwen-plus
# auto 优先 rembg，corner 仅四角抠图
MATTING_PROVIDER=auto
# auto 有 rapidocr 则拆出文字层，none 跳过
OCR_PROVIDER=auto
